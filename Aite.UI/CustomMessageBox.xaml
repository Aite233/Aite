<Window x:Class="Aite.WPF.CustomMessageBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CustomMessageBox"
        Width="320"
        Height="160"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        BorderBrush="#E2E8F0"
        BorderThickness="1">
    <Border CornerRadius="12"
            Background="#FFFFFF"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- 标题 -->
            <TextBlock x:Name="TitleText"
                       Grid.Row="0"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,16"
                       Foreground="#1A1A1A"/>
            
            <!-- 消息内容 -->
            <TextBlock x:Name="MessageText"
                       Grid.Row="1"
                       FontSize="14"
                       Foreground="#1A1A1A"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16"
                       MinHeight="40"/>
            
            <!-- 按钮网格 -->
            <Grid x:Name="ButtonGrid"
                  Grid.Row="2"
                  Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button x:Name="OkButton"
                        Grid.Column="0"
                        Content="确定"
                        Background="#0078D4"
                        Foreground="White"
                        BorderThickness="0"
                        Margin="5"
                        Height="36"
                        FontSize="14"
                        FontWeight="SemiBold"/>
                
                <Button x:Name="CancelButton"
                        Grid.Column="1"
                        Content="取消"
                        Background="#E0E0E0"
                        Foreground="#1A1A1A"
                        BorderThickness="0"
                        Margin="5"
                        Height="36"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Border>
</Window>