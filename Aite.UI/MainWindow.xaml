<Window x:Class="Aite.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Aite.WPF"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Aite" Height="768" Width="1100" WindowStartupLocation="CenterScreen" Background="Transparent" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True">
    <Border x:Name="MainBorder" Background="Transparent" CornerRadius="24" BorderBrush="#E2E8F0" BorderThickness="1" Padding="0">
        <Grid Background="Transparent">
            <Grid.Clip>
                <RectangleGeometry RadiusX="24" RadiusY="24" Rect="0,0,1100,768"/>
            </Grid.Clip>
            <!-- 主网格 -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- 标题栏 -->
            <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Background="Transparent" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <Grid MouseLeftButtonDown="Grid_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="20,0,0,0">
                        <Path Width="12" Height="12" Fill="#0078D4" Data="M0,6 L6,0 L12,6 L6,12 Z"/>
                        <TextBlock Text="Aite" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" Foreground="#1A1A1A"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button x:Name="MinimizeButton" Width="36" Height="36" Background="Transparent" BorderThickness="0" Foreground="#1A1A1A" Click="MinimizeButton_Click">
                            <TextBlock Text="—" FontSize="16" FontWeight="Bold"/>
                        </Button>
                        <Button x:Name="CloseButton" Width="36" Height="36" Background="Transparent" BorderThickness="0" Foreground="#1A1A1A" Click="CloseButton_Click">
                            <TextBlock Text="×" FontSize="16" FontWeight="Bold"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- 侧边栏 -->
            <Border Grid.Column="0" Grid.Row="1" Background="Transparent" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>
                    
                    <ScrollViewer Grid.Row="0" Margin="10,20,10,10" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Hidden">
                        <ListBox x:Name="NavigationList" Background="Transparent" BorderThickness="0">
                            <ListBoxItem Tag="home" Height="48" Background="Transparent" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,5,0,5" Padding="15,0,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🏠" Margin="0,0,10,0"/>
                                    <TextBlock Text="主页" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="accounts" Height="48" Background="Transparent" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,5,0,5" Padding="15,0,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="👤" Margin="0,0,10,0"/>
                                    <TextBlock Text="账号" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="servers" Height="48" Background="Transparent" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,5,0,5" Padding="15,0,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🖥️" Margin="0,0,10,0"/>
                                    <TextBlock Text="伺服" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                            </ListBoxItem>

                            <ListBoxItem Tag="proxy" Height="48" Background="Transparent" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,5,0,5" Padding="15,0,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🔌" Margin="0,0,10,0"/>
                                    <TextBlock Text="代理" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="plugins" Height="48" Background="Transparent" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,5,0,5" Padding="15,0,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🧩" Margin="0,0,10,0"/>
                                    <TextBlock Text="插件" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="plugin-store" Height="48" Background="Transparent" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,5,0,5" Padding="15,0,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🛒" Margin="0,0,10,0"/>
                                    <TextBlock Text="商城" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="logs" Height="48" Background="Transparent" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,5,0,5" Padding="15,0,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📋" Margin="0,0,10,0"/>
                                    <TextBlock Text="日志" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>
                    </ScrollViewer>
                    

                </Grid>
            </Border>
            
            <!-- 内容区域 -->
            <Border Grid.Column="1" Grid.Row="1" Background="Transparent">
                <ContentControl x:Name="ContentArea" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Border>
            
            <!-- 插件管理页面 -->
            <Grid x:Name="PluginsPage" Grid.Column="1" Grid.Row="1" Visibility="Collapsed">
                <Border Margin="20" Background="Transparent" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <TextBlock Text="插件管理" FontSize="24" FontWeight="Bold" Margin="0,0,0,8" Foreground="#1A1A1A"/>
                        <TextBlock Text="插件管理页面，用于管理系统中的插件。" FontSize="14" Margin="0,0,0,20" Foreground="#666666"/>
                        
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="插件列表" FontSize="16" FontWeight="SemiBold" Grid.Column="0"/>
                            <Button Content="刷新" Grid.Column="1" Background="LightGray" Foreground="Black" BorderThickness="0"/>
                        </Grid>
                        
                        <ScrollViewer Margin="0,0,0,16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Height="400">
                            <ListView BorderThickness="1" BorderBrush="#E2E8F0">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="名称" Width="200"/>
                                        <GridViewColumn Header="版本" Width="100"/>
                                        <GridViewColumn Header="作者" Width="150"/>
                                        <GridViewColumn Header="状态" Width="100"/>
                                        <GridViewColumn Header="操作" Width="150"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </ScrollViewer>
                        
                        <TextBlock Text="部分插件可能需要重启，才能彻底生效！" FontSize="12" Foreground="#666666"/>
                    </StackPanel>
                </Border>
            </Grid>
            
            <!-- 插件商城页面 -->
            <Grid x:Name="PluginStorePage" Grid.Column="1" Grid.Row="1" Visibility="Collapsed">
                <Border Margin="20" Background="Transparent" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <TextBlock Text="插件商城" FontSize="24" FontWeight="Bold" Margin="0,0,0,8" Foreground="#1A1A1A"/>
                        <TextBlock Text="浏览和下载各种插件，丰富您的服务器功能。" FontSize="14" Margin="0,0,0,20" Foreground="#666666"/>
                        
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="插件列表" FontSize="16" FontWeight="SemiBold" Grid.Column="0"/>
                            <Button Content="刷新" Grid.Column="1" Background="LightGray" Foreground="Black" BorderThickness="0"/>
                        </Grid>
                        
                        <ScrollViewer Margin="0,0,0,16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Height="400">
                            <ListView BorderThickness="1" BorderBrush="#E2E8F0">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="名称" Width="200"/>
                                        <GridViewColumn Header="描述" Width="200"/>
                                        <GridViewColumn Header="发布者" Width="150"/>
                                        <GridViewColumn Header="下载次数" Width="100"/>
                                        <GridViewColumn Header="操作" Width="100"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>
            

        </Grid>
    </Border>
</Window>