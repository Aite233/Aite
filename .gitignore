## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/master/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
IRCServer/

# Visual Studio cache/options directory
.vs/

# Mono auto generated files
mono_crash.*

# Build results of an ATL Project
[Dd]ebugPS/
[Rr]eleasePS/
dlldata.c

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# NuGet Packages
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
*.nuget.props
*.nuget.targets

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015 cache/options directory
.vs/

# Visual Studio Code
.vscode/

# Fantnel-master and EastSideNEL-master are third-party
Fantnel-master/
EastSideNEL-master/

# IRCServer is a Go project, maybe we don't need to commit it or commit only the source
IRCServer/go/
IRCServer/ircserver
IRCServer/ircserver.exe
IRCServer/go1.21.0.windows-amd64.msi
IRCServer/go1.21.0.windows-amd64.zip

# SDK bin folder
SDK/

# Resources folder
resources/

# Error log
error.log

# Aite.UI WPF temp files
*.cshtml
*.g.i.cs
*.g.cs

# Build
*.dll
*.exe
*.pdb
